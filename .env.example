# ==============================================================================
# Valuo - zero-key default endpoints (everything works without this file)
# Copy to .env at the repo root. quant/valuo/config.py and web/src/lib/env.ts both read it;
# an existing process environment variable always wins over .env (override=False).
# ==============================================================================

# 1. NEAR Mainnet JSON-RPC (supply, protocol config, validators, storage sinks, epoch issuance)
NEAR_RPC_URL=https://free.rpc.fastnear.com
NEAR_RPC_FALLBACK_URL=https://rpc.mainnet.near.org
# Historical view_account state (storage-growth measurement); non-archival nodes garbage-collect old blocks.
NEAR_ARCHIVAL_RPC_URL=https://archival-rpc.mainnet.fastnear.com

# 2. NEAR Intents 1Click API (live token universe and executable dry quotes)
ONECLICK_API_BASE=https://1click.chaindefuser.com
# Optional JWT (removes the unauthenticated appFee on quotes); leave empty for the public, key-free path.
ONECLICK_JWT=

# 3. Competitor routers for the live quote race (no keys)
RELAY_API_BASE=https://api.relay.link
LIFI_API_BASE=https://li.quest/v1
ACROSS_API_BASE=https://app.across.to/api

# 4. Volume, fees, on-chain receipts, peer multiples
NEARSTATS_API_BASE=https://nearstats.org/api/near
NEARBLOCKS_API_BASE=https://api.nearblocks.io/v1
# Optional NearBlocks key: only raises the rate limit for the receipt pages (sent as Authorization: Bearer).
NEARBLOCKS_API_KEY=
DEFILLAMA_API_BASE=https://api.llama.fi
COINS_LLAMA_BASE=https://coins.llama.fi
COINGECKO_API_BASE=https://api.coingecko.com/api/v3

# 5. Reproducibility
VALUO_MC_SEED=20261114
VALUO_MC_PATHS=10000
VALUO_HORIZON_MONTHS=36
VALUO_HTTP_TIMEOUT_S=20
# Spacing between NearBlocks calls (unauthenticated bursts are rate-limited). The collector reads this unless
# `python -m valuo.reproduce --nearblocks-delay S` is given explicitly (the flag defaults to unset).
VALUO_NEARBLOCKS_PAGE_DELAY_S=0.8
# Where canonical artifacts are written/read (default: <repo>/artifacts). The web reads the same directory.
# Non-default runs (--skip-bench, --paths != VALUO_MC_PATHS, ...) write to <artifacts>/dev/ unless --out DIR is passed.
# VALUO_ARTIFACTS_DIR=/absolute/path/to/artifacts

# 6. Quote-race recipients (dry quotes need syntactically valid addresses; nothing is ever sent).
# Keep these identical for quant and web. The BTC default is the BIP173 P2WPKH test vector; the BIP173
# *example* address bc1qar0srrr7xfkvy5l643lydnw9re59gtzzwf5mdq is on Relay's blocklist.
VALUO_EVM_ADDRESS=0xd8dA6BF26964aF9D7eEd9e03E53415D37aA96045
VALUO_SOL_ADDRESS=7EcDhSYGxXyscszYEp35KHN8vvw3svAuLKTzXwCFLtV
VALUO_BTC_ADDRESS=bc1qw508d6qejxtdg4y5r3zarvary0c5xw7kv8f3t4

# 7. Web terminal (web/)
NEXT_PUBLIC_APP_NAME=Valuo
# Set to 1 to enable the in-browser "Reproduce" button (spawns `uv run python -m valuo.reproduce` in VALUO_QUANT_DIR).
VALUO_ALLOW_REPRODUCE=0
# VALUO_QUANT_DIR=/absolute/path/to/quant
# Per-venue timeout for /api/live-benchmark (ms).
VALUO_BENCH_TIMEOUT_MS=12000
